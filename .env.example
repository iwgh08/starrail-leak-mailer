# 이 파일을 복사해서 이름을 .env 로 바꾼 뒤 값을 채우세요.

# 보내는 Gmail 주소와 앱 비밀번호(16자리, 공백 있어도 됨)
GMAIL_ADDRESS=minihy08@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# 받는 주소 (비워두면 GMAIL_ADDRESS로 보냄)
MAIL_TO=

# (선택) Reddit API 앱 정보. 넣으면 요청 제한이 분당 1회 → 약 100회로 늘어남.
# 비워두면 지금처럼 RSS로 수집합니다. 만드는 법은 README 참고.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
