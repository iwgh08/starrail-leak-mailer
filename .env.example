# 이 파일을 복사해서 이름을 .env 로 바꾼 뒤 값을 채우세요.

# 보내는 Gmail 주소와 앱 비밀번호(16자리, 공백 있어도 됨)
GMAIL_ADDRESS=minihy08@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# 받는 주소 (비워두면 GMAIL_ADDRESS로 보냄)
MAIL_TO=

# (선택) Reddit API 앱 정보. 넣으면 요청 제한이 분당 1회 → 약 100회로 늘어남.
# 비워두면 지금처럼 RSS로 수집합니다. 만드는 법은 README 참고.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# (선택) 아이폰용 웹 리포트 — Cloudflare Pages에 올리고 Cloudflare Access로 잠금. 만드는 법은 README 참고.
# 비워두면 웹 배포를 건너뛰고 메일만 보냅니다.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
SITE_URL=

# (선택) 실시간 알림(웹 푸시) 키 — 직접 넣지 말고 python hsr_news.py --setup-push 로 만드세요.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=

# (선택) 정리 리포트 메일: fallback(기본, 웹 업로드나 아이폰 알림이 실패할 때만 메일) / always(늘 메일) / off
MAIL_MODE=fallback
# (선택) 방해 금지 시간(한국 시간, 예: 01-08). 이 시간의 알림은 모았다가 끝난 뒤 한 번에 보냄. 비우면 사용 안 함.
QUIET_HOURS=01-08
# (선택) 관심 캐릭터(쉼표로 구분, 예: 반디,카프카). 방해 금지 시간에도 바로 알리고 ⭐를 붙임.
FAVORITE_CHARACTERS=
